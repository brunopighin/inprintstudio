DATABASE_URL="file:./prod.db"
JWT_SECRET="change_this_to_a_long_random_secret"
PORT=3004
NODE_ENV=production
CORS_ORIGIN="https://inprintstudio.com.ar"
FRONTEND_URL="https://inprintstudio.com.ar"
MP_ACCESS_TOKEN="TEST-xxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx"
MP_WEBHOOK_SECRET="webhook-signature-secret-from-mp-dashboard"

# Código postal de origen del envío (local/depósito único).
ORIGIN_POSTAL_CODE="1900"

# API "MiCorreo" de Correo Argentino. MICORREO_USER/PASSWORD son el email y
# contraseña de la cuenta de vendedor (se dan de alta en
# https://www.correoargentino.com.ar/MiCorreo) — se usan contra /users/validate
# para obtener el customerId, no para firmar el /token. El customerId ya NO se
# configura a mano: se resuelve solo y se cachea en memoria.
MICORREO_BASE_URL="https://apitest.correoargentino.com.ar/micorreo/v1"
MICORREO_USER=""
MICORREO_PASSWORD=""
# El /token se firma con una credencial de "integrador" fija que Correo da a
# todo integrador (no es propia de esta cuenta) — dejar vacío usa el default
# conocido (el mismo que usa el plugin oficial de WooCommerce de Correo).
# Solo completar si Correo entrega una credencial de integrador distinta.
MICORREO_INTEGRATOR_USER=""
MICORREO_INTEGRATOR_PASS=""
# Datos del remitente (tu local/depósito), requeridos solo para generar el
# envío desde el admin (/shipping/import) — no hacen falta para cotizar.
SENDER_NAME=""
SENDER_PHONE=""
SENDER_EMAIL=""
SENDER_STREET=""
SENDER_NUMBER=""
SENDER_FLOOR=""
SENDER_APARTMENT=""
SENDER_CITY=""
SENDER_PROVINCE=""
SENDER_POSTAL_CODE=""

# Andreani: el cotizador de tarifas NO es de autoservicio (el sandbox público
# solo cubre su API de logística en depósito propio). Hay que gestionar un
# contrato comercial con un ejecutivo de cuenta de Andreani para conseguir
# número de contrato/cliente y la documentación real del endpoint de tarifas
# antes de poder completar esta integración (ver backend/src/utils/shippingProviders/andreani.ts).

# OCA (webservice ePak, Oep_TrackEPak.asmx / Tarifar_Envio_Corporativo).
# Cuit y Operativa son datos de la cuenta comercial OCA (Operativa = código de
# servicio contratado, se obtiene con GetOperativasByUsuario o lo entrega OCA).
# Ambiente de pruebas: https://integraciones.ocadev.com.ar/epak_tracking_test/Oep_TrackEPak.asmx
# Producción: https://webservice.oca.com.ar/ePak_tracking/Oep_TrackEPak.asmx
OCA_BASE_URL="https://integraciones.ocadev.com.ar/epak_tracking_test/Oep_TrackEPak.asmx"
OCA_CUIT=""
OCA_OPERATIVA=""
